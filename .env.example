# MotionLife service credentials — copy this file to `.env` and fill in your key.
#   cp .env.example .env   &&   $EDITOR .env
# The launchers (service/run-router.sh) auto-load .env. `.env` is gitignored.

# Anthropic API key for the VLM Router (Step 1). Replace the placeholder below.
# When a real key is set the router uses the direct Anthropic API; otherwise it
# falls back to Amazon Bedrock via the standard AWS credential chain.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# --- OR --- use an Amazon Bedrock API key (bearer token) instead of the above.
# When set, the router calls Claude via Bedrock with this token (no AWS SigV4 creds
# needed). These tokens are typically short-lived. Uncomment and paste yours:
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
